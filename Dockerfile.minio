# Official source releases, pinned because the legacy community image tags
# are no longer reliably available from the public registries.
FROM golang:1.27.4 AS source
ENV CGO_ENABLED=0

FROM source AS server-build
RUN go install github.com/minio/minio@v0.0.0-20251015172955-9e49d5e7a648

FROM source AS client-build
RUN go install github.com/minio/mc@v0.0.0-20250813083541-7394ce0dd2a8

FROM busybox:1.36 AS minio
COPY --from=server-build /go/bin/minio /usr/local/bin/minio
COPY --from=server-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=server-build /go/pkg/mod/github.com/minio/minio@v0.0.0-20251015172955-9e49d5e7a648/LICENSE /licenses/minio-AGPL-3.0.txt
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]

FROM busybox:1.36 AS mc
COPY --from=client-build /go/bin/mc /usr/local/bin/mc
COPY --from=client-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=client-build /go/pkg/mod/github.com/minio/mc@v0.0.0-20250813083541-7394ce0dd2a8/LICENSE /licenses/mc-AGPL-3.0.txt
ENTRYPOINT ["mc"]
